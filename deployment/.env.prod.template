# Production Environment Configuration for Smainer Relayer
# Copy this file to .env.prod and update with actual production values

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Starknet Configuration
STARKNET_RPC_URL=https://free-rpc.nethermind.io/mainnet-juno
RELAYER_PRIVATE_KEY=REQUIRED_REPLACE_WITH_SECURE_MAINNET_PRIVATE_KEY
RELAYER_ACCOUNT_ADDRESS=0x071cd50ddd9a2d0e1e95e6decd9f0a292b489dc6b9b13e68aac43b2295b626d6
CONTRACT_ADDRESS=0x044bf558b2e5ba7b3b24a18ff4944833ef9526b47907bcbdcbf94c33f4431abe

# API Security
API_KEY=REPLACE_WITH_SECURE_API_KEY
CALLBACK_SIGNING_SECRET=REPLACE_WITH_SECURE_CALLBACK_SIGNING_SECRET
CALLBACK_ALLOWED_HOSTS=api.smainer.io,bot.smainer.io
PORT=8000
HOST=0.0.0.0

# CORS & Security
CORS_ORIGINS=https://smainer.io,https://www.smainer.io
ALLOWED_HOSTS=api.smainer.io,smainer.io,www.smainer.io

# Production Features
RELAYER_ENABLE_BATCH_SUBMISSION=true
LOG_LEVEL=INFO

# Task Configuration
TASK_TIMEOUT_SECONDS=300
BATCH_INTERVAL_SECONDS=60
MAX_BATCH_SIZE=10
NODE_HEARTBEAT_TIMEOUT=90

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090