# Smainer Relayer Production Environment Configuration
# Copy this file to .env.prod and update all placeholder values

# === SECURITY CRITICAL - UPDATE THESE ===
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-25)
API_KEY=sk-CHANGE_ME_SECURE_API_KEY_$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-25)
RELAYER_PRIVATE_KEY=REQUIRED_REPLACE_WITH_SECURE_MAINNET_PRIVATE_KEY

# === STARKNET CONFIGURATION ===
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io
# For testnet: https://starknet-sepolia.public.blastapi.io
CONTRACT_ADDRESS=0x0747d450d0304b01f52c901bb362428b385c4a86f1e346c80b69a3b6df0da90d

# === APPLICATION SETTINGS ===
LOG_LEVEL=INFO
ENABLE_BATCH_SUBMISSION=false
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# === PERFORMANCE TUNING ===
TASK_TIMEOUT_SECONDS=300
BATCH_INTERVAL_SECONDS=60
MAX_BATCH_SIZE=10
NODE_HEARTBEAT_TIMEOUT=90

# === RATE LIMITING ===
RATE_LIMIT_PER_MINUTE=120

# Example generation commands:
# Redis password: openssl rand -base64 32 | tr -d "=+/" | cut -c1-25
# API key: echo "sk-$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-25)"